{
  "functions": {
    "api/seo.js": {
      "includeFiles": "index.html"
    }
  },
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/og-home.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/book/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/book/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot[/;\\-)]|[Bb]ot$|[Cc]rawl|[Ss]pider|facebookexternalhit|Facebot|WhatsApp|Pinterest|Embedly|Iframely|vkShare|SkypeUriPreview|Viber|Bluesky|Mastodon|Google-|GoogleOther|Mediapartners|meta-external|Applebot|[Ii]nspectionTool).*"
        }
      ],
      "destination": "/api/seo?slug=:slug"
    },
    {
      "source": "/book/:slug/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot[/;\\-)]|[Bb]ot$|[Cc]rawl|[Ss]pider|facebookexternalhit|Facebot|WhatsApp|Pinterest|Embedly|Iframely|vkShare|SkypeUriPreview|Viber|Bluesky|Mastodon|Google-|GoogleOther|Mediapartners|meta-external|Applebot|[Ii]nspectionTool).*"
        }
      ],
      "destination": "/api/seo?slug=:slug"
    },
    {
      "source": "/book/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/book/:slug/",
      "destination": "/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?sitemap=1"
    }
  ]
}
